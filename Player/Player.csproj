<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><PlatformTarget>x64</PlatformTarget><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/*.png" />
    <Resource Include="Assets/app-icon.ico" />
    <ProjectReference Include="../Core/Core.csproj" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <None Update="player.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="$(PlayerConfigFile)" LogicalName="SecureVideo.PlayerConfig" Condition="'$(PlayerConfigFile)' != ''" />
    <EmbeddedResource Include="ffmpeg/manifest.json" LogicalName="SecureVideo.FFmpegManifest" Condition="Exists('ffmpeg/manifest.json')" />
    <None Update="ffmpeg/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

